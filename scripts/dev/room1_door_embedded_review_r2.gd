extends "res://scripts/dev/room1_door_sensor_review_r1.gd"

## Independent visual candidate for the Room 1 main door.
## It intentionally reuses the r1 recognition, scan, sliding and exit-boundary logic.
## The inherited wall/floor bake is not regenerated by this candidate.

const DOOR_WIDTH := 1.37
const DOOR_HEIGHT := 2.30
const DOOR_DEPTH := 0.085
const DOOR_LIGHT_SHADER := preload("res://scripts/dev/room1_dynamic_door_strip_lighting_r2.gdshader")

var original_door_mesh: MeshInstance3D
var original_door_body: StaticBody3D
var embedded_door_root: Node3D
var embedded_door_collision: CollisionShape3D
var door_materials: Array[ShaderMaterial] = []

func _ready() -> void:
	super._ready()
	if Engine.is_editor_hint() or not is_instance_valid(door_mesh) or not is_instance_valid(door_body):
		return
	_replace_placeholder_with_embedded_door()
	_sync_door_lighting()

func _process(delta: float) -> void:
	super._process(delta)
	_sync_door_lighting()

func _replace_placeholder_with_embedded_door() -> void:
	original_door_mesh = door_mesh
	original_door_body = door_body
	original_door_mesh.visible = false
	original_door_body.collision_layer = 0
	original_door_body.collision_mask = 0
	if is_instance_valid(door_bloom_occluder):
		door_bloom_occluder.visible = false

	embedded_door_root = Node3D.new()
	embedded_door_root.name = "EmbeddedAutoDoorR2"
	add_child(embedded_door_root)

	var slab := _make_box_mesh(
		"EmbeddedDoorSlab",
		Vector3(DOOR_WIDTH, DOOR_HEIGHT, DOOR_DEPTH),
		Color("92A6A6"),
		Vector3.ZERO
	)
	embedded_door_root.add_child(slab)
	slab.global_position = door_closed_position
	_make_trim(slab)

	var body := StaticBody3D.new()
	body.name = "EmbeddedDoorBodyR2"
	body.collision_layer = 1
	body.collision_mask = 2
	embedded_door_root.add_child(body)
	body.global_position = door_closed_position
	embedded_door_collision = CollisionShape3D.new()
	var shape := BoxShape3D.new()
	shape.size = Vector3(DOOR_WIDTH, DOOR_HEIGHT, DOOR_DEPTH)
	embedded_door_collision.shape = shape
	body.add_child(embedded_door_collision)

	# The inherited state machine moves these two references together.
	door_mesh = slab
	door_body = body
	door_closed_position = slab.global_position
	body_closed_position = body.global_position

func _make_trim(slab: MeshInstance3D) -> void:
	# Three very shallow seams read as a recessed, machine-made door without
	# introducing a terminal, handle, visible authentication panel, or extra prop.
	var recess_color := Color("4B6869")
	for specification in [
		["InsetFace", Vector3(1.10, 1.82, 0.012), Vector3(0.0, 0.0, 0.049)],
		["UpperReveal", Vector3(1.20, 0.045, 0.020), Vector3(0.0, 0.94, 0.059)],
		["LowerReveal", Vector3(1.20, 0.045, 0.020), Vector3(0.0, -0.94, 0.059)],
		["LeftReveal", Vector3(0.045, 1.92, 0.020), Vector3(-0.62, 0.0, 0.059)],
		["RightReveal", Vector3(0.045, 1.92, 0.020), Vector3(0.62, 0.0, 0.059)]
	]:
		var trim := _make_box_mesh(specification[0], specification[1], recess_color, specification[2])
		slab.add_child(trim)

func _make_box_mesh(node_name: String, size: Vector3, color: Color, local_position: Vector3) -> MeshInstance3D:
	var mesh := BoxMesh.new()
	mesh.size = size
	var material := ShaderMaterial.new()
	material.shader = DOOR_LIGHT_SHADER
	material.set_shader_parameter("base_tint", color)
	material.set_shader_parameter("strip_on", 1.0 if strip_on else 0.0)
	door_materials.append(material)
	var instance := MeshInstance3D.new()
	instance.name = node_name
	instance.mesh = mesh
	instance.material_override = material
	instance.position = local_position
	instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	return instance

func _sync_door_lighting() -> void:
	for material in door_materials:
		material.set_shader_parameter("strip_on", 1.0 if strip_on else 0.0)
